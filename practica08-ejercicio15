#include <iostream>
#include <string>
using namespace std;

int leerTamano();
void leerAlumnos(string nombres[], double notas[], int n);
void ordenarPorNota(string nombres[], double notas[], int n);
void mostrarTresMejores(string nombres[], double notas[]);

int main() {
    string nombres[100];
    double notas[100];

    int n = leerTamano();
    leerAlumnos(nombres, notas, n);
    ordenarPorNota(nombres, notas, n);
    mostrarTresMejores(nombres, notas);

    return 0;
}

// Minimo 3 estudiantes para poder sacar el podio
int leerTamano() {
    int n;
    do {
        cout << "Cantidad de estudiantes (3 a 100): ";
        cin >> n;
        if (n < 3 || n > 100) {
            cout << "Cantidad no valida, intente de nuevo." << endl;
        }
    } while (n < 3 || n > 100);
    return n;
}

void leerAlumnos(string nombres[], double notas[], int n) {
    cin.ignore(1000, '\n');  // limpia el enter que quedo despues de leer n
    for (int i = 0; i < n; i++) {
        cout << "\nNombre del estudiante " << i + 1 << ": ";
        getline(cin, nombres[i]);
        do {
            cout << "Nota (0 a 100): ";
            cin >> notas[i];
            if (notas[i] < 0 || notas[i] > 100) {
                cout << "La nota debe estar entre 0 y 100." << endl;
            }
        } while (notas[i] < 0 || notas[i] > 100);
        cin.ignore(1000, '\n');
    }
}

// Burbuja de mayor a menor; cada vez que se cambia una nota tambien se cambia el nombre
void ordenarPorNota(string nombres[], double notas[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (notas[j] < notas[j + 1]) {
                double auxNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = auxNota;

                string auxNombre = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = auxNombre;
            }
        }
    }
}

void mostrarTresMejores(string nombres[], double notas[]) {
    cout << "\n--- Tres mejores notas ---" << endl;
    for (int i = 0; i < 3; i++) {
        cout << i + 1 << ". " << nombres[i] << " - " << notas[i] << endl;
    }
}
