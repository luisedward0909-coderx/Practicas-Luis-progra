#include <iostream>
using namespace std;

int leerTamano();
void leerVector(int a[], int n);
void mostrarVector(int v[], int n);
bool yaEsta(int v[], int cantidad, int valor);
int quitarDuplicados(int a[], int n, int b[]);

int main() {
    int a[100], b[100];
    int n = leerTamano();
    leerVector(a, n);

    int cantidad = quitarDuplicados(a, n, b);

    cout << "\nVector A: ";
    mostrarVector(a, n);
    cout << "Vector B sin repetidos: ";
    mostrarVector(b, cantidad);
    cout << "Elementos validos en B: " << cantidad << endl;

    return 0;
}

int leerTamano() {
    int n;
    do {
        cout << "Cantidad de elementos (1 a 100): ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Cantidad no valida, intente de nuevo." << endl;
        }
    } while (n < 1 || n > 100);
    return n;
}

void leerVector(int a[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "A[" << i << "]: ";
        cin >> a[i];
    }
}

void mostrarVector(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

// Busca el valor dentro de los primeros "cantidad" elementos de v
bool yaEsta(int v[], int cantidad, int valor) {
    for (int i = 0; i < cantidad; i++) {
        if (v[i] == valor) {
            return true;
        }
    }
    return false;
}

// Pasa a B solo los valores que todavia no estan; devuelve cuantos quedaron
int quitarDuplicados(int a[], int n, int b[]) {
    int cantidad = 0;
    for (int i = 0; i < n; i++) {
        if (!yaEsta(b, cantidad, a[i])) {
            b[cantidad] = a[i];
            cantidad++;
        }
    }
    return cantidad;
}
