
#include <iostream>
using namespace std;

int pedirCantidad();
void cargarVector(double vec[], int n);
void imprimirVector(double vec[], int n);
void clasificarNumeros(double vec[], int n, int &positivos, int &negativos, int &ceros);
void mostrarResultados(int positivos, int negativos, int ceros);

int main() {
    double vec[100];
    int n = pedirCantidad();

    cargarVector(vec, n);

    cout << "\nVector ingresado: ";
    imprimirVector(vec, n);

    int positivos, negativos, ceros;

    clasificarNumeros(vec, n, positivos, negativos, ceros);
    mostrarResultados(positivos, negativos, ceros);

    return 0;
}

int pedirCantidad() {
    int n;

    do {
        cout << "Digite la cantidad de elementos (1 a 100): ";
        cin >> n;

        if (n < 1 || n > 100) {
            cout << "Cantidad incorrecta, intente nuevamente." << endl;
        }

    } while (n < 1 || n > 100);

    return n;
}

void cargarVector(double vec[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Digite el elemento [" << i << "]: ";
        cin >> vec[i];
    }
}

void imprimirVector(double vec[], int n) {
    for (int i = 0; i < n; i++) {
        cout << vec[i] << " ";
    }

    cout << endl;
}

void clasificarNumeros(double vec[], int n, int &positivos, int &negativos, int &ceros) {
    positivos = 0;
    negativos = 0;
    ceros = 0;

    for (int i = 0; i < n; i++) {
        if (vec[i] > 0) {
            positivos++;

        } else if (vec[i] < 0) {
            negativos++;

        } else {
            ceros++;
        }
    }
}

void mostrarResultados(int positivos, int negativos, int ceros) {
    cout << "Cantidad de positivos: " << positivos << endl;
    cout << "Cantidad de negativos: " << negativos << endl;
    cout << "Cantidad de ceros: " << ceros << endl;
}
