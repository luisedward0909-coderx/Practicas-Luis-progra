#include <iostream>
#include <string>
#include <cctype>
using namespace std;

int mostrarMenu();
void registrarAlumno(string nombres[], double notas[], int &cantidad, int capacidad);
void listarAlumnos(string nombres[], double notas[], int cantidad);
string aMinusculas(string texto);
void ordenarPorNombre(string nombres[], double notas[], int cantidad);
void mostrarMejores(string nombres[], double notas[], int cantidad);
double calcularPromedio(double notas[], int cantidad);

int main() {
    string nombres[30];
    double notas[30];
    int cantidad = 0;
    int opcion;

    do {
        opcion = mostrarMenu();

        switch (opcion) {
            case 1:
                registrarAlumno(nombres, notas, cantidad, 30);
                break;
            case 2:
                listarAlumnos(nombres, notas, cantidad);
                break;
            case 3:
                ordenarPorNombre(nombres, notas, cantidad);
                break;
            case 4:
                mostrarMejores(nombres, notas, cantidad);
                break;
            case 5:
                if (cantidad == 0) {
                    cout << "No hay alumnos registrados." << endl;
                } else {
                    cout << "Promedio de notas: " << calcularPromedio(notas, cantidad) << endl;
                }
                break;
            case 6:
                cout << "Saliendo del programa..." << endl;
                break;
        }
    } while (opcion != 6);

    return 0;
}

int mostrarMenu() {
    int opcion;
    do {
        cout << "\n===== GESTION DE ALUMNOS =====" << endl;
        cout << "1) Registrar alumno y nota" << endl;
        cout << "2) Listar alumnos" << endl;
        cout << "3) Ordenar alfabeticamente por nombre" << endl;
        cout << "4) Mostrar alumno(s) con la nota mas alta" << endl;
        cout << "5) Calcular el promedio de notas" << endl;
        cout << "6) Salir" << endl;
        cout << "Elija una opcion: ";
        cin >> opcion;
        if (opcion < 1 || opcion > 6) {
            cout << "Opcion no valida." << endl;
        }
    } while (opcion < 1 || opcion > 6);
    return opcion;
}

void registrarAlumno(string nombres[], double notas[], int &cantidad, int capacidad) {
    if (cantidad >= capacidad) {
        cout << "El arreglo esta lleno, no se pueden registrar mas alumnos." << endl;
        return;
    }

    string nombre;
    cin.ignore(1000, '\n');
    do {
        cout << "Nombre del alumno: ";
        getline(cin, nombre);
        if (nombre == "") {
            cout << "El nombre no puede estar vacio." << endl;
        }
    } while (nombre == "");

    double nota;
    do {
        cout << "Nota (0 a 100): ";
        cin >> nota;
        if (nota < 0 || nota > 100) {
            cout << "La nota debe estar entre 0 y 100." << endl;
        }
    } while (nota < 0 || nota > 100);

    nombres[cantidad] = nombre;
    notas[cantidad] = nota;
    cantidad++;
    cout << "Alumno registrado." << endl;
}

void listarAlumnos(string nombres[], double notas[], int cantidad) {
    if (cantidad == 0) {
        cout << "No hay alumnos registrados." << endl;
        return;
    }
    cout << "\n--- Lista de alumnos ---" << endl;
    for (int i = 0; i < cantidad; i++) {
        cout << i + 1 << ". " << nombres[i] << " - " << notas[i] << endl;
    }
}

// Sirve para que "ana" y "Ana" se comparen igual al ordenar
string aMinusculas(string texto) {
    for (int i = 0; i < texto.length(); i++) {
        texto[i] = tolower(texto[i]);
    }
    return texto;
}

void ordenarPorNombre(string nombres[], double notas[], int cantidad) {
    if (cantidad == 0) {
        cout << "No hay alumnos para ordenar." << endl;
        return;
    }
    for (int i = 0; i < cantidad - 1; i++) {
        for (int j = 0; j < cantidad - 1 - i; j++) {
            if (aMinusculas(nombres[j]) > aMinusculas(nombres[j + 1])) {
                string auxNombre = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = auxNombre;

                double auxNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = auxNota;
            }
        }
    }
    cout << "Lista ordenada alfabeticamente." << endl;
}

// Primero busca la nota mas alta y luego muestra a todos los que la tengan (por si hay empate)
void mostrarMejores(string nombres[], double notas[], int cantidad) {
    if (cantidad == 0) {
        cout << "No hay alumnos registrados." << endl;
        return;
    }
    double mayor = notas[0];
    for (int i = 1; i < cantidad; i++) {
        if (notas[i] > mayor) {
            mayor = notas[i];
        }
    }
    cout << "\nNota mas alta: " << mayor << endl;
    for (int i = 0; i < cantidad; i++) {
        if (notas[i] == mayor) {
            cout << "- " << nombres[i] << endl;
        }
    }
}

double calcularPromedio(double notas[], int cantidad) {
    double suma = 0;
    for (int i = 0; i < cantidad; i++) {
        suma = suma + notas[i];
    }
    return suma / cantidad;
}
